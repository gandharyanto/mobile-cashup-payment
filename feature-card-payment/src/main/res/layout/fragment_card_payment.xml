<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/calculatorScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <LinearLayout
            android:id="@+id/amountPanel"
            android:layout_width="0dp"
            android:layout_height="86dp"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="11dp"
            android:paddingEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/calculatorExpression"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/instrument_sans_regular"
                android:text="@string/card_payment_amount_hint"
                android:textColor="@color/card_payment_hint"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/calculatorTotal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/instrument_sans_semibold"
                    android:text="@string/card_payment_zero"
                    android:textColor="@color/card_payment_amount_empty"
                    android:textSize="25sp" />

                <ImageButton
                    android:id="@+id/amountBackspace"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/card_payment_backspace"
                    android:padding="7dp"
                    android:src="@drawable/ic_backspace"
                    app:tint="@color/card_payment_amount_empty" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/card_payment_divider" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/simpleKeypad"
            android:layout_width="0dp"
            android:layout_height="407dp"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/amountPanel">

            <LinearLayout style="@style/CardPaymentKeypadRow">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/simpleKey1"
                    style="@style/CardPaymentKeyButton"
                    android:text="1" />

                <Space style="@style/CardPaymentKeyGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/simpleKey2"
                    style="@style/CardPaymentKeyButton"
                    android:text="2" />

                <Space style="@style/CardPaymentKeyGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/simpleKey3"
                    style="@style/CardPaymentKeyButton"
                    android:text="3" />
            </LinearLayout>

            <Space style="@style/CardPaymentRowGap" />

            <LinearLayout style="@style/CardPaymentKeypadRow">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/simpleKey4"
                    style="@style/CardPaymentKeyButton"
                    android:text="4" />

                <Space style="@style/CardPaymentKeyGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/simpleKey5"
                    style="@style/CardPaymentKeyButton"
                    android:text="5" />

                <Space style="@style/CardPaymentKeyGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/simpleKey6"
                    style="@style/CardPaymentKeyButton"
                    android:text="6" />
            </LinearLayout>

            <Space style="@style/CardPaymentRowGap" />

            <LinearLayout style="@style/CardPaymentKeypadRow">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/simpleKey7"
                    style="@style/CardPaymentKeyButton"
                    android:text="7" />

                <Space style="@style/CardPaymentKeyGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/simpleKey8"
                    style="@style/CardPaymentKeyButton"
                    android:text="8" />

                <Space style="@style/CardPaymentKeyGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/simpleKey9"
                    style="@style/CardPaymentKeyButton"
                    android:text="9" />
            </LinearLayout>

            <Space style="@style/CardPaymentRowGap" />

            <LinearLayout style="@style/CardPaymentKeypadRow">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/showCalculator"
                    style="@style/CardPaymentToggleButton"
                    app:icon="@drawable/ic_payment_calculator" />

                <Space style="@style/CardPaymentKeyGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/simpleKey000"
                    style="@style/CardPaymentKeyButton"
                    android:text="000" />

                <Space style="@style/CardPaymentKeyGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/simpleKey0"
                    style="@style/CardPaymentKeyButton"
                    android:text="0" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/calculatorKeypad"
            android:layout_width="0dp"
            android:layout_height="407dp"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/amountPanel">

            <LinearLayout style="@style/CardPaymentKeypadRow">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyClear"
                    style="@style/CardPaymentClearButton"
                    android:text="C" />

                <Space style="@style/CardPaymentCalcGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyBackspace"
                    style="@style/CardPaymentOperatorButton"
                    app:icon="@drawable/ic_backspace" />

                <Space style="@style/CardPaymentCalcGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyPercent"
                    style="@style/CardPaymentOperatorButton"
                    android:text="%" />

                <Space style="@style/CardPaymentCalcGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyDivide"
                    style="@style/CardPaymentOperatorButton"
                    android:text="÷" />
            </LinearLayout>

            <Space style="@style/CardPaymentCalcRowGap" />

            <LinearLayout style="@style/CardPaymentKeypadRow">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key1"
                    style="@style/CardPaymentKeyButton"
                    android:text="1" />

                <Space style="@style/CardPaymentCalcGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key2"
                    style="@style/CardPaymentKeyButton"
                    android:text="2" />

                <Space style="@style/CardPaymentCalcGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key3"
                    style="@style/CardPaymentKeyButton"
                    android:text="3" />

                <Space style="@style/CardPaymentCalcGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyMultiply"
                    style="@style/CardPaymentOperatorButton"
                    android:text="×" />
            </LinearLayout>

            <Space style="@style/CardPaymentCalcRowGap" />

            <LinearLayout style="@style/CardPaymentKeypadRow">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key4"
                    style="@style/CardPaymentKeyButton"
                    android:text="4" />

                <Space style="@style/CardPaymentCalcGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key5"
                    style="@style/CardPaymentKeyButton"
                    android:text="5" />

                <Space style="@style/CardPaymentCalcGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key6"
                    style="@style/CardPaymentKeyButton"
                    android:text="6" />

                <Space style="@style/CardPaymentCalcGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyMinus"
                    style="@style/CardPaymentOperatorButton"
                    android:text="−" />
            </LinearLayout>

            <Space style="@style/CardPaymentCalcRowGap" />

            <LinearLayout style="@style/CardPaymentKeypadRow">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key7"
                    style="@style/CardPaymentKeyButton"
                    android:text="7" />

                <Space style="@style/CardPaymentCalcGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key8"
                    style="@style/CardPaymentKeyButton"
                    android:text="8" />

                <Space style="@style/CardPaymentCalcGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key9"
                    style="@style/CardPaymentKeyButton"
                    android:text="9" />

                <Space style="@style/CardPaymentCalcGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyPlus"
                    style="@style/CardPaymentOperatorButton"
                    android:text="+" />
            </LinearLayout>

            <Space style="@style/CardPaymentCalcRowGap" />

            <LinearLayout style="@style/CardPaymentKeypadRow">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hideCalculator"
                    style="@style/CardPaymentOperatorButton"
                    app:icon="@drawable/ic_payment_keypad" />

                <Space style="@style/CardPaymentCalcGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key000"
                    style="@style/CardPaymentKeyButton"
                    android:text="000" />

                <Space style="@style/CardPaymentCalcGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/key0"
                    style="@style/CardPaymentKeyButton"
                    android:text="0" />

                <Space style="@style/CardPaymentCalcGap" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyEquals"
                    style="@style/CardPaymentEqualsButton"
                    android:text="=" />
            </LinearLayout>
        </LinearLayout>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/keypadBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="simpleKeypad,calculatorKeypad" />

        <LinearLayout
            android:id="@+id/paymentButtons"
            android:layout_width="0dp"
            android:layout_height="116dp"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/keypadBottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pay"
                    style="@style/CardPaymentPayButton"
                    android:layout_marginEnd="4dp"
                    android:text="@string/card_payment_debit_credit"
                    app:icon="@drawable/ic_card_contactless" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/payQris"
                    style="@style/CardPaymentPayButton"
                    android:layout_marginStart="4dp"
                    android:text="QRIS"
                    app:icon="@drawable/ic_payment_qris" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/otherPayment"
                style="@style/CardPaymentOtherButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:text="@string/card_payment_other"
                app:icon="@drawable/ic_payment_other" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/paymentScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_container"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/card_payment_back"
            android:padding="10dp"
            android:src="@drawable/ic_back_white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="28dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_payment_amount_label"
                    android:textColor="@color/card_payment_text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/amountValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/instrument_sans_semibold"
                    android:textColor="@color/card_payment_text"
                    android:textSize="20sp"
                    tools:text="Rp 134.600" />

                <pl.droidsonroids.gif.GifImageButton
                    android:id="@+id/cardAnimation"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_marginTop="12dp"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside"
                    android:src="@drawable/card_payment_anfu" />

                <TextView
                    android:id="@+id/prompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/card_payment_insert_or_tap"
                    android:textColor="@color/card_payment_blue"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/card_payment_muted"
                    android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/secondaryAction"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/card_payment_change"
                    android:textAllCaps="false"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
