        <mxCell id="n23" value="POST&amp;nbsp;v1/terminal-key-provisioning/qr-redeem&lt;br&gt;-------------------------------------------&lt;br&gt;REQ&amp;nbsp;&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;challengeCode&quot;:&amp;nbsp;&amp;nbsp;&quot;ABCD-1234&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;serialNumber&quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;PAX-A920-0012938&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;rsaPublicKey&quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;MIIBIjANBgkqhkiG9w0...&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;eddsaPublicKey&quot;:&amp;nbsp;&quot;MCowBQYDK2VwAyEA...&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;}&lt;br&gt;&lt;br&gt;RESP&amp;nbsp;data&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;orderId&quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;ord_7f3a91&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;activationToken&quot;:&amp;nbsp;&quot;eyJhbGciOi...&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;}&lt;br&gt;&lt;br&gt;Tanpa&amp;nbsp;X-Signature&amp;nbsp;-&amp;nbsp;backend&amp;nbsp;belum&amp;nbsp;mengenal&amp;nbsp;public&amp;nbsp;key&amp;nbsp;device;&lt;br&gt;kunci&amp;nbsp;itu&amp;nbsp;baru&amp;nbsp;dikirim&amp;nbsp;di&amp;nbsp;request&amp;nbsp;ini&amp;nbsp;sendiri." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacingLeft=8;spacingTop=4;fillColor=#fbfbfb;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="450" y="130" width="520" height="240" as="geometry" />
        </mxCell>
        <mxCell id="n24" value="POST&amp;nbsp;v1/terminal-key-provisioning/orders/{orderId}/package&lt;br&gt;----------------------------------------------------------&lt;br&gt;REQ&amp;nbsp;&amp;nbsp;{&amp;nbsp;&quot;orderId&quot;:&amp;nbsp;&quot;ord_7f3a91&quot;,&amp;nbsp;&quot;activationToken&quot;:&amp;nbsp;&quot;eyJhbGciOi...&quot;&amp;nbsp;}&lt;br&gt;&lt;br&gt;RESP&amp;nbsp;data&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;orderId&quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;ord_7f3a91&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;wrappedPackageKey&quot;:&amp;nbsp;&amp;nbsp;&quot;base64(RSA-OAEP(...))&quot;,&amp;nbsp;&amp;nbsp;&amp;nbsp;//&amp;nbsp;#4&amp;nbsp;DUKPT&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;appEddsaPublicKey&quot;:&amp;nbsp;&amp;nbsp;&quot;MCowBQYDK2VwAyEA...&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;}&lt;br&gt;&lt;br&gt;Backend:&amp;nbsp;generate&amp;nbsp;keyId&amp;nbsp;(KSN)&amp;nbsp;-&amp;gt;&amp;nbsp;Get&amp;nbsp;IPEK&amp;nbsp;dari&amp;nbsp;Payment&amp;nbsp;HSM&amp;nbsp;-&amp;gt;&lt;br&gt;Get&amp;nbsp;ED25519&amp;nbsp;Public&amp;nbsp;Key&amp;nbsp;dari&amp;nbsp;General&amp;nbsp;Purpose&amp;nbsp;HSM&amp;nbsp;-&amp;gt;&amp;nbsp;kirim&amp;nbsp;IPEK&lt;br&gt;dibungkus&amp;nbsp;RSA.&amp;nbsp;Signed&amp;nbsp;(X-Signature&amp;nbsp;dst,&amp;nbsp;lihat&amp;nbsp;spec&amp;nbsp;§3.3)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacingLeft=8;spacingTop=4;fillColor=#fbfbfb;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="450" y="420" width="520" height="198" as="geometry" />
        </mxCell>
        <mxCell id="n25" value="POST&amp;nbsp;v1/terminal-key-provisioning/orders/{orderId}/activate&lt;br&gt;----------------------------------------------------------&lt;br&gt;REQ&amp;nbsp;&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;activationToken&quot;:&amp;nbsp;&amp;nbsp;&quot;eyJhbGciOi...&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;keyCheckValues&quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;{&amp;nbsp;&quot;&amp;lt;purpose&amp;gt;&quot;:&amp;nbsp;&quot;&amp;lt;kcv&amp;nbsp;hex&amp;gt;&quot;&amp;nbsp;}&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;}&lt;br&gt;&lt;br&gt;RESP&amp;nbsp;data&amp;nbsp;{&amp;nbsp;&quot;status&quot;:&amp;nbsp;&quot;OK&quot;&amp;nbsp;}&lt;br&gt;&lt;br&gt;Signed.&amp;nbsp;Langkah&amp;nbsp;16&amp;nbsp;diagram&amp;nbsp;tim&amp;nbsp;(&quot;Callback&amp;nbsp;Provisioning&amp;nbsp;Status&quot;&amp;nbsp;ke&lt;br&gt;App&amp;nbsp;Provisioning)&amp;nbsp;bukan&amp;nbsp;urusan&amp;nbsp;app&amp;nbsp;ini&amp;nbsp;-&amp;nbsp;backend&amp;nbsp;yang&amp;nbsp;memberitahu,&lt;br&gt;EDC&amp;nbsp;tidak&amp;nbsp;mengirim&amp;nbsp;apa&amp;nbsp;pun&amp;nbsp;ke&amp;nbsp;App&amp;nbsp;Provisioning." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacingLeft=8;spacingTop=4;fillColor=#fbfbfb;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="450" y="700" width="520" height="184" as="geometry" />
        </mxCell>
        <mxCell id="n26" value="&lt;b&gt;Tiga key, tiga tempat (spec §4.1)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;RSA-2048&lt;/b&gt; (unwrap identitas) — AndroidKeyStore kalau MGF1 backend memungkinkan (§4.5), fallback BouncyCastle + EncryptedSharedPreferences.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ed25519&lt;/b&gt; (signing request) — BouncyCastle + EncryptedSharedPreferences. &lt;b&gt;TIDAK hardware-backed&lt;/b&gt;: &lt;code&gt;KEY_ALGORITHM_ED25519&lt;/code&gt; tidak ada di Android sampai API 37.&lt;br&gt;&lt;br&gt;&lt;b&gt;DUKPT (IPEK/KSN)&lt;/b&gt; — modul vendor dulu, vault TEE sebagai cermin (&lt;code&gt;DuktpVaultCompat&lt;/code&gt;), hanya ditulis kalau modul vendor konfirmasi sukses." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="1000" y="130" width="420" height="300" as="geometry" />
        </mxCell>
        <mxCell id="n27" value="Error&amp;nbsp;yang&amp;nbsp;khas&amp;nbsp;di&amp;nbsp;alur&amp;nbsp;ini&lt;br&gt;---------------------------&lt;br&gt;PROVISIONING_TOKEN_INVALID&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;token/QR&amp;nbsp;tidak&amp;nbsp;valid,&amp;nbsp;sudah&amp;nbsp;dipakai,&amp;nbsp;atau&amp;nbsp;kedaluwarsa&lt;br&gt;TERMINAL_KEY_ALREADY_PROVISIONED&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;device&amp;nbsp;sudah&amp;nbsp;pernah&amp;nbsp;diprovisioning&amp;nbsp;penuh&lt;br&gt;TERMINAL_NOT_REGISTERED&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;device&amp;nbsp;belum&amp;nbsp;terdaftar&amp;nbsp;di&amp;nbsp;backend&lt;br&gt;TERMINAL_INACTIVE&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;device&amp;nbsp;tidak&amp;nbsp;aktif&lt;br&gt;DEVICE_SIGNATURE_REQUIRED&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;signature&amp;nbsp;tidak&amp;nbsp;diterima&amp;nbsp;backend&lt;br&gt;&lt;br&gt;Selalu&amp;nbsp;branch&amp;nbsp;pada&amp;nbsp;error.code,&amp;nbsp;tidak&amp;nbsp;pernah&amp;nbsp;pada&amp;nbsp;error.message." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacingLeft=8;spacingTop=4;fillColor=#fbfbfb;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="1000" y="460" width="420" height="142" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
