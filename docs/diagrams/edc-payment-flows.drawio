p;nbsp;&amp;nbsp;&amp;nbsp;&quot;acquirerName&quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;BCA&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;applicationLabel&quot;:&amp;nbsp;&quot;DEBIT&amp;nbsp;BCA&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;isDebit&quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;true&lt;br&gt;&amp;nbsp;&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;qris&quot;:&amp;nbsp;{&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;//&amp;nbsp;hadir&amp;nbsp;hanya&amp;nbsp;bila&amp;nbsp;instrument&amp;nbsp;=&amp;nbsp;QRIS_*&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;qrPayload&quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;00020101021226...&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;wallet&quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;GOPAY&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;customerPan&quot;:&amp;nbsp;&amp;nbsp;&quot;936000...&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;customerName&quot;:&amp;nbsp;&quot;B***&amp;nbsp;S***&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;issuerName&quot;:&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;Gopay&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;metadata&quot;:&amp;nbsp;{}&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;//&amp;nbsp;titipan&amp;nbsp;pemanggil,&amp;nbsp;tidak&amp;nbsp;ditafsirkan&lt;br&gt;}" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;spacingLeft=8;spacingTop=4;fillColor=#fbfbfb;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="1010" y="130" width="520" height="520" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="&lt;b&gt;is_debit_check &amp;amp; card_routing_check&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dua endpoint terpisah di app lama. &lt;code&gt;isDebit&lt;/code&gt; sekarang jadi field di &lt;code&gt;data.card&lt;/code&gt; pada response yang sama — satu round-trip hilang dari setiap transaksi kartu.&lt;br&gt;&lt;br&gt;&lt;code&gt;card_routing_check&lt;/code&gt; ditunda dari v1 sesuai spec §2, bersama &lt;code&gt;loyalty_point_trx&lt;/code&gt;." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="460" y="560" width="520" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n19" value="&lt;b&gt;Kartu ditolak ≠ error HTTP&lt;/b&gt;&lt;br&gt;&lt;br&gt;Penolakan issuer adalah hasil bisnis, bukan kegagalan API: &lt;b&gt;HTTP 200&lt;/b&gt; dengan &lt;code&gt;data.status = &quot;DECLINED&quot;&lt;/code&gt; dan &lt;code&gt;data.approvalCode = null&lt;/code&gt;. Device menampilkan layar Declined, bukan layar error jaringan.&lt;br&gt;&lt;br&gt;Ini penting karena &lt;code&gt;safeApiCall&lt;/code&gt; memetakan non-2xx ke &lt;code&gt;ApiResult.Failure&lt;/code&gt; — kalau decline dikirim sebagai 4xx, device akan salah menyebutnya gangguan koneksi." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
          <mxGeometry x="460" y="700" width="520" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
