        <mxCell id="n2" value="&quot;Static&quot; = tanpa amount ter-embed, BUKAN QR yang dipakai berulang · tetap generate ulang tiap sesi" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1">
