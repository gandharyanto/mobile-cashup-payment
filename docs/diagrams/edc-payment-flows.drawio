          <mxGeometry x="60" y="292" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;POST .../qr-redeem&lt;/b&gt;&lt;br&gt;TANPA signature (device belum terdaftar)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="373" width="320" height="55" as="geometry" />
