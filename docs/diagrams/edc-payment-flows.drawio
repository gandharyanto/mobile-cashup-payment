          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;Kenapa halaman ini tidak punya kontrak HTTP&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;code&gt;Provisioning.drawio&lt;/code&gt; tim (sumber kewenangan tertinggi untuk bentuk body, spec provisioning §1) hanya memuat J1. Tidak ada sequence diagram untuk refresh key atau deaktivasi.&lt;br&gt;&lt;br&gt;Path/body di bawah ini sebelumnya dikarang sebagai &lt;code&gt;POST /v1/provisioning/refresh&lt;/code&gt; dan &lt;code&gt;POST /v1/provisioning/deactivate&lt;/code&gt; — &lt;b&gt;keduanya tidak pernah ada di kontrak nyata manapun&lt;/b&gt; dan sudah dibuang dari halaman ini. Menunggu backend menyediakan endpoint (spec provisioning §10) sebelum diagram ini diisi ulang." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="1">
