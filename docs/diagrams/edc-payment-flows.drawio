        <mxCell id="e22" value="retry, tanpa login (tidak ada login sama sekali)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#555555;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="n20" target="n4">
