<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#F5F7FA">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Cashup Payment" android:textColor="#163A55" android:textStyle="bold"
            android:textSize="28sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Sale kartu uji"
            android:textColor="#526476" android:textSize="16sp" />
        <TextView android:id="@+id/serialNumber" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/serial_loading" android:textIsSelectable="true"
            android:textColor="#526476" android:textSize="14sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="Nominal (IDR)" android:textStyle="bold" />
        <EditText android:id="@+id/amount" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="number"
            android:hint="Contoh: 10000" android:maxLength="12" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Tip (opsional)" android:textStyle="bold" />
        <EditText android:id="@+id/tip" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="number"
            android:hint="0" android:maxLength="12" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Kartu uji" android:textStyle="bold" />
        <Spinner android:id="@+id/card" android:layout_width="match_parent"
            android:layout_height="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="PIN (opsional)" android:textStyle="bold" />
        <EditText android:id="@+id/pin" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="numberPassword"
            android:maxLength="12" android:hint="4–12 digit" />
        <Button android:id="@+id/pay" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="28dp"
            android:text="Bayar" />
        <Button android:id="@+id/provisionAgain" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="Provision ulang" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Simulasi decrypt RSA (Base64)"
            android:textStyle="bold" />
        <TextView android:id="@+id/result" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:textColor="#163A55" android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
