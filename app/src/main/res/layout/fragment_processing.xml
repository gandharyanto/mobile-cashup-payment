<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical">

    <include layout="@layout/layout_provisioning_header" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            style="@style/Cashup.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <!-- Progress indicator standar, bukan animasi kustom (spec §11). -->
            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:indeterminateTint="@color/brand_primary" />

            <TextView
                android:id="@+id/title"
                style="@style/Cashup.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/processing_title" />

            <!--
                Label langkah, bukan animasi (spec §11). Ceremony ini menunggu dua HSM
                di DOWNLOAD_PACKAGE; tanpa label ini spinner terlihat sama persis
                seperti aplikasi yang menggantung.
            -->
            <TextView
                android:id="@+id/step"
                style="@style/Cashup.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                tools:text="Langkah: DOWNLOAD_PACKAGE" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
